# ---------------------------------------------------------------------------
# C64 Zelda - .gitignore
# ---------------------------------------------------------------------------

# Fichiers de compilation C64
build/
*.prg
*.d64
*.vs
*.rep
*.dat
*.crt

# Données sources et ROMs protégées (non publiées sur GitHub)
*.nes
zelda.nes
assets/nes/
tools/*nes*
tools/extract_overworld_enemies.py
1.png

# Logs et scripts temporaires d'émulateur VICE
*.mon
*.out
*.log
monitor.log
screenshots/

# Sauvegardes et temporaires
*.bak
*.backup
*~
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# IDE et OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large world PNG files - moved to docs/images/
world_original.png
world_original_cave.png
world_preview.png

# Additional image patterns for space savings (after keeping 1.png)
*.png !1.png !docs/images/*.png

# Generated build artifacts in build directory (keep source work)
build/*.prg
build/*.dat
